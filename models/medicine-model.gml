creator "Sixing Huang"
version "2"
graph [
	node [
		$id "mdcn01"
		tags "Medicine"
		$map 0
		$path "$"
		*label "medicine_name"
		medicine_name "medicine_name"
		umls_id "umls_id"
		rxnorm_id "rxnorm_id"
		pubchem_cid "pubchem_cid"
		smiles "smiles"
		kegg_id "kegg_id"
		side_effects "side_effects"
	]
]
